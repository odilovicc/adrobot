# Keitaro tracker. Defaults point to the bundled mock (make mock / make dev).
KEITARO_URL=http://127.0.0.1:8100
KEITARO_API_KEY=mock-key

DATABASE_URL=sqlite:///./adrobot.db

# Pre-selected values in the campaign creator (ids from Keitaro).
DEFAULT_DOMAIN_ID=1
DEFAULT_GROUP_ID=1
DEFAULT_TRAFFIC_SOURCE_ID=1
